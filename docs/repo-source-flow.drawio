<mxfile host="app.diagrams.net">
  <diagram name="Agama install source selection" id="agama-repo-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;How Agama (SLE-16) picks the main install source&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;From software/manager.rb &lt;i&gt;add_base_repos&lt;/i&gt; and product_builder.rb &lt;i&gt;set_repositories&lt;/i&gt; (read from source; Full-ISO case verified live on 16.0 GM)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="50" as="geometry"/>
        </mxCell>

        <!-- main flow -->
        <mxCell id="start" value="&lt;b&gt;Software probe&lt;/b&gt;&lt;br&gt;add_base_repos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="dud" value="1. Driver-update repo&lt;br&gt;(only if /run/agama/dud has one)&lt;br&gt;&lt;i&gt;added, flow continues&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="2. Install media found&lt;br&gt;by &lt;b&gt;label&lt;/b&gt;?&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;installation_labels, e.g. SLES160-x86_64&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="280" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="d2" value="3. /run/initramfs/live/install&lt;br&gt;exists?&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(Full ISO)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="280" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="online" value="4. &lt;b&gt;product.repositories&lt;/b&gt;&lt;br&gt;(online repos from product YAML,&lt;br&gt;or &lt;b&gt;inst.install_url&lt;/b&gt; if set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- results -->
        <mxCell id="r1" value="&lt;b&gt;Base repo = local media&lt;/b&gt;&lt;br&gt;hd:/?device=...&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;stop here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="335" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Base repo = Full media&lt;/b&gt;&lt;br&gt;/install on the live medium&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;stop here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="515" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Base repo = online URL(s)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="690" width="210" height="40" as="geometry"/>
        </mxCell>

        <!-- edges main -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="dud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="dud" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="online"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="online" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- install_url box -->
        <mxCell id="iu" value="&lt;b&gt;inst.install_url=URL[,URL2]&lt;/b&gt;&lt;br&gt;kernel arg (launch-demo.sh: INSTALL_URL)&lt;br&gt;Replaces product.repositories only.&lt;br&gt;Boot-time only, no API endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="660" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="iu" target="online"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="810"/><mxPoint x="210" y="810"/></Array></mxGeometry></mxCell>

        <!-- warning -->
        <mxCell id="warn" value="&lt;b&gt;&amp;#9888; Gotcha on the Full ISO&lt;/b&gt;&lt;br&gt;Steps 2 and 3 succeed first, so step 4 never runs and &lt;b&gt;inst.install_url is ignored&lt;/b&gt;. It only takes effect when no local media is found (e.g. online/minimal ISO)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="470" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="warn" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- extra repos lane -->
        <mxCell id="lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1080" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lanelabel" value="&lt;b&gt;Afterwards: extra repositories&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="55" y="855" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="extra" value="&lt;b&gt;extraRepositories&lt;/b&gt;&lt;br&gt;PUT software/config, sw_add_repository, or profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="890" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="extra2" value="Added &lt;b&gt;after&lt;/b&gt; the base repo, so they get higher libzypp source ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="430" y="890" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="extra3" value="&lt;b&gt;Always additive&lt;/b&gt;. Base repo = lowest source id; entry order in the list does not promote anything to main." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="890" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="extra" target="extra2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="extra2" target="extra3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
